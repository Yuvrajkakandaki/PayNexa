# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Port the Express server listens on
PORT=5000

# Allowed CORS origin — the URL of your React frontend.
# In development this is the Vite dev server.
# In production set this to your deployed frontend URL (e.g. https://paynexa.onrender.com).
FRONTEND_URL=http://localhost:5173

# PayPal Sandbox credentials
# Get these from developer.paypal.com → My Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID generated in PayPal Developer Dashboard → Webhooks
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Google Gemini API key
# Get this from aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model to use (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# MongoDB connection string
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/
MONGODB_URI=your_mongodb_connection_string_here

# JWT Authentication Secret (min 32 characters)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
